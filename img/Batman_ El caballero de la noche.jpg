ros argumentales, anacronismos","title_subpage_goofs_seeSpoilers":"{spoilersCount, plural, one {Ver {spoilersCount} spoiler} other {Ver {spoilersCount} spoilers}}","title_subpage_goofs_seeThisEntry":"Ver esta entrada","title_subpage_goofs_shareLinks_emailSubject":"¡Mira este enlace en IMDb!","title_subpage_goofs_shareLinks_label":"Abrir menú de errores","title_subpage_goofs_sharedWithYou":"COMPARTIDOS CONTIGO","title_subpage_goofs_signpost_spoilers":"SPOILERS","title_subpage_goofs_subPageTitle":"Errores","title_subpage_goofs_titleString":"Spoilers y bloopers","title_subpage_keywords_title":"Palabras clave de la trama","title_subpage_locations_crazy_credits_interested":"{usersInterested} de {usersVoted} encontraron esto interesante","title_subpage_locations_filming_dates":"Fechas de filmación","title_subpage_locations_filming_locations":"Locaciones de filmación","title_subpage_locations_filming_production_location":"Filmación y producción","title_subpage_locations_production_dates":"Fechas de producción","title_subpage_metacritic_reviews":"Opiniones de Metacritic","title_subpage_moreFrom":"Más de {titleName}","title_subpage_parentalguide_meta_description":"de Certificaciones y Certificaciones de todo el mundo.","title_subpage_parentalguide_meta_keywords":"Guía para padres, guía principal","title_subpage_parentalguide_category_additem":"Agregar un producto","title_subpage_parentalguide_category_rate_text":"Califica este título para {category}:","title_subpage_parentalguide_category_severitybreakdown_show":"Mostrar desglose y voto","title_subpage_parentalguide_category_severityexplanation":"{votes} de {total} encontraron esto {severity}","title_subpage_parentalguide_category_severityexplanation_after_user_voted":"Calificaste este título como {severity} para {category}","title_subpage_parentalguide_category_severityexplanation_none":"{votes} de {total} consideran que esto tiene {severity}","title_subpage_parentalguide_category_severityexplanation_first_vote":"Sé el prim